{
  "name": "pcmt/custom-dataset-bundle",
  "description": "Custom Dataset Bundle for PCMT",
  "type": "library",
  "license": "GPL-3.0-only",
  "authors": [
    {
      "name": "Josh Zamor",
      "email": "josh.zamor@villagereach.org"
    }
  ],
  "autoload": {
    "psr-4": {
      "PcmtCustomDatasetBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "PcmtCustomDatasetBundle\\Tests\\": "src/Tests/"
    }
  },
  
  "repositories": [
    {
        "type": "vcs",
        "url": "https://gitlab.com/pcmt/shared-bundle.git"
    },
    {
      "type": "vcs",
      "url": "https://gitlab.com/pcmt/core-bundle.git"
    },
    {
      "type": "vcs",
      "url": "https://gitlab.com/pcmt/draft-bundle.git"
    },
    {
      "type": "vcs",
      "url": "https://gitlab.com/pcmt/custom-entity-bundle.git"
    }
  ],
  "require": {
    "php": "8.0.*",
    "akeneo/pim-community-dev": "^6.0",
    "pcmt/shared-bundle": "dev-master@dev",
    "sabre/xml": "dev-master",
    "pcmt/core-bundle": "dev-master@dev",
    "phpoffice/phpspreadsheet": "^2.1",
    "akeneo-labs/custom-entity-bundle": "dev-master@dev",
    "pcmt/draft-bundle": "dev-master@dev"
  },
  "require-dev": {
    "phpunit/phpunit": "^9",
    "symplify/easy-coding-standard": "^12"
  },
  "config": {
    "allow-plugins": {
      "symfony/flex": true
    }
  },
  "minimum-stability": "dev"
}
